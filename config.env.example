# Bitly API 설정 — config.env 로 복사해서 값 채우기 (install.sh가 자동 처리)
# ⚠️ config.env 는 절대 커밋 금지 (.gitignore 처리됨).
#
# 전사 공유: 같은 BITLY_GROUP_GUID 토큰을 팀이 함께 쓰면 `list` 모드로 전체 링크가 한 번에 집계됨.
# 토큰 발급: https://app.bitly.com/settings/api/  (Generic Access Token)

BITLY_TOKEN=여기에_공유_그룹_토큰_붙여넣기
BITLY_GROUP_GUID=Bq4tcFdJw53
